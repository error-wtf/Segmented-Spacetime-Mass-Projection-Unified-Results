    ],
    "storage": "500 MB free space (for outputs)"
  },
  
  "usage_examples": {
    "full_pipeline": "python ssz_animation_master.py",
    "specific_languages": "python ssz_animation_master.py --languages de en",
    "wsl_mode": "python ssz_animation_master.py --use-wsl",
    "audio_only": "python ssz_animation_master.py --skip-render",
    "quick_test": "python test_pipeline_quick.py",
    "windows_launcher": ".\\run_ssz_animation.ps1"
  },
  
  "performance": {
    "tts_generation": "10-30 seconds per language",
