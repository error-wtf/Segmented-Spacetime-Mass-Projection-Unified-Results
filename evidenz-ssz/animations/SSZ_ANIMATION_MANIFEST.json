  "troubleshooting": {
    "espeak_not_found": {
      "solution": [
        "Windows: choco install espeak-ng",
        "WSL: wsl sudo apt install espeak-ng",
        "Use --use-wsl flag for WSL mode"
      ]
    },
    
    "ffmpeg_not_found": {
      "solution": [
        "Windows: choco install ffmpeg",
        "Linux: sudo apt install ffmpeg"
      ]
    },
    
    "audio_too_short": {
      "cause": "TTS generation failed",
      "solution": [
        "Check logs: D:\\SSZ_Render\\logs\\tts_fallback_XX.txt",
        "Regenerate with slower speed: espeak-ng -s 140"
      ]
    },
    
    "rendering_slow": {
      "optimization": [
        "Reduce FPS to 24",
        "Reduce resolution to 720p",
        "Close other applications"
      ]
    }
  },
  
